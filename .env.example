# Copy to .env in the directory where you run ntr server; never put token contents here.
# Existing process variables override these values, including explicit empty values.
TASK_BACKEND=homeassistant
HA_URL=https://homeassistant.lan:8123
HA_TODO_ENTITY=todo.personal_tasks
# Default entity above handles unselected projects; all visible HA lists become projects.
# Opt in only behind a trusted/authenticated ntr connection; requires an HA admin token.
HA_MANAGE_LISTS=false
HA_TOKEN_FILE=./secrets/ha-token
# Remove HA_CA_FILE when the HA certificate is already trusted by the system.
HA_CA_FILE=./certificates/homeassistant.lanCA.crt
HA_METADATA_FILE=./ha-metadata.json
HA_POLL_SECONDS=10
